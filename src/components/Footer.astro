---
import { NAV, SITE, CONTACT } from '../data/site'
import { ACCREDITATIONS } from '../data/compliance'
---

<footer class="ftr">
  <div class="page">
    <div class="ftr__top">
      <div class="ftr__brand">
        <p class="ftr__line">{SITE.tagline}</p>
        <div class="ftr__accs">
          {ACCREDITATIONS.map((a) => (
            <span class="tag tag--gold">{a.mark} · {a.detail}</span>
          ))}
        </div>
      </div>

      <nav class="ftr__nav" aria-label="Footer">
        {NAV.map((col) => (
          <div>
            <h2 class="micro">{col.label}</h2>
            <ul>
              {(col.children ?? [col]).map((c) => (
                <li><a href={c.href}>{c.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <h2 class="micro">Start</h2>
          <ul>
            <li><a href="/start">Start your project</a></li>
            <li><a href="/contact">Book a discovery call</a></li>
            <li><a href="/services/compliance-check">Check my artwork</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="ftr__bottom">
      <p class="small">
        Manufacturing with us too? <a href={SITE.manufacturingUrl}>Supplement Factory</a> makes the
        product this pack goes on.
      </p>
      <p class="small ftr__contact">
        {CONTACT.namedPerson ?? 'Design team'} · <a href={`mailto:${CONTACT.fallbackEmail}`}>{CONTACT.fallbackEmail}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--dark);
    color: var(--on-dark-2);
    padding-block: var(--s9) var(--s6);
    margin-top: var(--s10);
  }
  .ftr__top {
    display: grid;
    gap: var(--s8);
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: var(--s8);
    border-bottom: 1px solid var(--rule-dark);
  }
  @media (min-width: 900px) {
    .ftr__top { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); }
  }
  .ftr__line {
    font-size: var(--t-h3);
    color: var(--on-dark);
    letter-spacing: -.015em;
    line-height: 1.25;
    max-width: 18em;
  }
  .ftr__accs { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s5); }
  .ftr__accs .tag { background: transparent; border-color: var(--gold-lo); color: var(--gold-hi); }

  .ftr__nav {
    display: grid;
    gap: var(--s6);
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .ftr__nav h2 { color: var(--on-dark-3); margin-bottom: var(--s3); font-weight: 700; }
  .ftr__nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .ftr__nav a { font-size: var(--t-small); text-decoration: none; }
  .ftr__nav a:hover { color: var(--gold-hi); }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4);
    justify-content: space-between;
    padding-top: var(--s5);
  }
  .ftr__bottom p { margin: 0; max-width: none; }
  .ftr__bottom a { color: var(--gold-hi); }
  .ftr__contact { color: var(--on-dark-3); }
</style>

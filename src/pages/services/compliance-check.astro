---
import Base from '../../layouts/Base.astro'
import PageHero from '../../components/PageHero.astro'
import { COMPLIANCE_PRODUCTS, gbp } from '../../data/pricing'
import { CHECKS, CAUGHT, PROMISE, ARTWORK_SPEC } from '../../data/compliance'
---

<Base
  title="Compliance Check Service — £750, or £1,000 with the amendment"
  description="Already have artwork? Our technical and quality team review it against the rules of your market — twelve checks, delivered as a report with the modifications needed. £750, or £1,000 including one amendment."
>
  <PageHero
    eyebrow="Compliance check"
    title="You already have a design. You are not sure it is legal where you sell."
    lead="Our technical and quality team review the artwork against the rules of your market and tell you exactly what has to change. Twelve checks, delivered as a report."
  >
    <div class="btn-row">
      <a href="/start?service=compliance-check" class="btn btn--primary">Buy the check</a>
      <a href="#what" class="btn btn--ghost">What it covers</a>
    </div>
  </PageHero>

  <section class="section section--ground">
    <div class="page">
      <div class="grid grid-2" style="max-width: 820px">
        {COMPLIANCE_PRODUCTS.map((p, i) => (
          <article class="card">
            <div>
              <span class="micro">{i === 0 ? 'Review' : 'Review and fix'}</span>
              <h3 style="margin-top: var(--s2)">{p.name}</h3>
            </div>
            <p class="price price--gold">{gbp(p.price)}<sup>+VAT</sup></p>
            <p class="small" style="color: var(--ink-2)">{p.forWhom}</p>
            <a href={`/start?service=${p.id}`} class="btn btn--ink" style="margin-top: auto; align-self: flex-start">
              Buy {p.name}
            </a>
          </article>
        ))}
      </div>
      <p class="small" style="margin-top: var(--s5); color: var(--ink-3)">Per artwork. VAT applies to UK-based clients.</p>
    </div>
  </section>

  <section class="section" id="what">
    <div class="page split">
      <div>
        <span class="eyebrow">Twelve checks</span>
        <h2>What the review covers</h2>
        <p class="lead" style="margin-top: var(--s5)">
          The same checklist our technical and quality team run on every pack we design ourselves.
        </p>
      </div>
      <ol class="checks">
        {CHECKS.map((c, i) => (
          <li>
            <span class="checks__n spec">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <strong>{c.name}</strong>
              <p class="small">{c.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark">
    <div class="page">
      <span class="eyebrow">Caught before print</span>
      <h2>Two real ones</h2>
      <div class="grid grid-2" style="margin-top: var(--s7); max-width: 900px">
        {CAUGHT.map((c) => (
          <article class="caught">
            <h3>{c.headline}</h3>
            <p>{c.detail}</p>
          </article>
        ))}
      </div>
      <p class="promise">{PROMISE}</p>
    </div>
  </section>

  <section class="section">
    <div class="page page--narrow">
      <span class="eyebrow">Sending us your artwork</span>
      <h2>What to send, and in what form</h2>
      <dl class="spec-list">
        <dt>Artwork</dt><dd>{ARTWORK_SPEC.accepted}</dd>
        <dt>Logos</dt><dd>{ARTWORK_SPEC.logos}</dd>
        <dt>Keep clear</dt><dd>{ARTWORK_SPEC.keepClear}</dd>
      </dl>
      <div class="btn-row" style="margin-top: var(--s7)">
        <a href="/start?service=compliance-check" class="btn btn--primary">Buy the check</a>
        <a href="/compliance" class="btn btn--ghost">How compliance works here</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5); }
  .checks li { display: grid; grid-template-columns: 34px 1fr; gap: var(--s4); }
  .checks__n { color: var(--gold-lo); font-weight: 800; font-size: var(--t-small); }
  .checks p { color: var(--ink-2); margin: var(--s1) 0 0; }

  .caught { border-top: 2px solid var(--gold); padding-top: var(--s5); }
  .caught h3 { color: var(--on-dark); margin-bottom: var(--s3); }
  .caught p { color: var(--on-dark-2); }

  .promise {
    margin-top: var(--s8);
    padding-left: var(--s5);
    border-left: 3px solid var(--gold);
    font-size: var(--t-lead);
    color: var(--on-dark);
    max-width: 46ch;
  }

  .spec-list { margin: var(--s6) 0 0; display: grid; gap: 0; }
  .spec-list dt {
    font-size: var(--t-micro);
    letter-spacing: .1em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 86;
    color: var(--ink-3);
    font-weight: 700;
    padding-top: var(--s4);
    border-top: 1px solid var(--rule);
  }
  .spec-list dd { margin: var(--s2) 0 var(--s4); color: var(--ink-2); }
</style>
